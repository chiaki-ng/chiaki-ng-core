IOS_DEPLOYMENT_TARGET ?= 26.0
IOS_ARCHITECTURES ?= arm64

ios_cross_args = -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_ARCHITECTURES="$(IOS_ARCHITECTURES)" \
	-DCMAKE_OSX_DEPLOYMENT_TARGET="$(IOS_DEPLOYMENT_TARGET)" \
	-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH \
	-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH -DCMAKE_IGNORE_PREFIX_PATH="/opt/homebrew;/usr/local;/opt/local"

ios_HOST := darwin
ios_TESTS :=
ios_REQUIRES := DEPS_PREFIX
ios_CMAKE_ARGS = $(ios_cross_args) -DCMAKE_OSX_SYSROOT=iphoneos

ios-simulator_HOST := darwin
ios-simulator_TESTS :=
ios-simulator_REQUIRES := DEPS_PREFIX
ios-simulator_CMAKE_ARGS = $(ios_cross_args) -DCMAKE_OSX_SYSROOT=iphonesimulator
