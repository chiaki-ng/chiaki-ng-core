DEVKITPRO ?= /opt/devkitpro

switch_HOST := linux
switch_TESTS :=
switch_REQUIRES := DEPS_PREFIX
switch_CMAKE_ARGS = -DCMAKE_TOOLCHAIN_FILE="$(DEVKITPRO)/cmake/Switch.cmake" \
	-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH \
	-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH -DLIBCHIAKING_SYSTEM_SIMDUTF=ON \
	-DLIBCHIAKING_CRYPTO_OPENSSL=OFF -DLIBCHIAKING_CRYPTO_BORINGSSL=OFF -DLIBCHIAKING_CRYPTO_LIBNX=ON \
	-DLIBCHIAKING_MINIUPNPC=OFF
