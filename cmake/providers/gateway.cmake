option(LIBCHIAKING_MINIUPNPC "Build the UPnP gateway mapping provider" ON)
if(LIBCHIAKING_MINIUPNPC)
    find_path(LIBCHIAKING_MINIUPNPC_INCLUDE_DIR miniupnpc/miniupnpc.h)
    find_library(LIBCHIAKING_MINIUPNPC_LIBRARY NAMES miniupnpc)
endif()
option(LIBCHIAKING_MINIUPNPC_STATIC "Link miniupnpc as a static library" OFF)
if(LIBCHIAKING_MINIUPNPC_LIBRARY MATCHES "\\.a$")
    set(LIBCHIAKING_MINIUPNPC_STATIC ON)
endif()
if(LIBCHIAKING_MINIUPNPC AND LIBCHIAKING_MINIUPNPC_INCLUDE_DIR AND LIBCHIAKING_MINIUPNPC_LIBRARY)
    add_library(libchiaking_gateway STATIC src/platform/gateway/miniupnpc.cpp)
    target_include_directories(libchiaking_gateway SYSTEM PRIVATE "${LIBCHIAKING_MINIUPNPC_INCLUDE_DIR}")
    target_link_libraries(libchiaking_gateway PRIVATE "${LIBCHIAKING_MINIUPNPC_LIBRARY}")
    if(LIBCHIAKING_MINIUPNPC_STATIC)
        target_compile_definitions(libchiaking_gateway PRIVATE ${LIBCHIAKING_PLATFORM_MINIUPNPC_STATIC_DEFINITIONS})
    endif()
    target_link_libraries(libchiaking_gateway PRIVATE ${LIBCHIAKING_PLATFORM_GATEWAY_LIBRARIES})
else()
    add_library(libchiaking_gateway STATIC src/platform/gateway/unavailable.cpp)
endif()
target_link_libraries(libchiaking_gateway PUBLIC libchiaking)
libchiaking_enable_strict_warnings(libchiaking_gateway)
