PROJECT_NAME           = libchiaking
PROJECT_NUMBER         = $(LIBCHIAKING_VERSION)
PROJECT_BRIEF          = "PlayStation remote play and cloud streaming as a C++23 library"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = docs/doxygen/mainpage.md \
                         docs/doxygen/api.dox \
                         docs/doxygen/namespaces.dox \
                         docs/doxygen/internal_namespaces.dox \
                         docs/doxygen/directories.dox \
                         docs/BUILDING.md \
                         docs/CPP_STYLE.md \
                         include/libchiaking \
                         src/core \
                         src/platform
FILE_PATTERNS          = *.hpp *.h *.md *.dox
RECURSIVE              = YES
EXCLUDE                = src/core/net/protocol/takion/generated
USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md
LAYOUT_FILE            = docs/doxygen/DoxygenLayout.xml

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        =
STRIP_FROM_INC_PATH    = include
INCLUDE_PATH           = . include

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXCLUDE_SYMBOLS        = detail *::detail *::detail::* glz glz::*
BUILTIN_STL_SUPPORT    = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
INLINE_SIMPLE_STRUCTS  = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
GROUP_GRAPHS           = NO
DIRECTORY_GRAPH        = NO
