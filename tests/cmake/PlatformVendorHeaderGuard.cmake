if(NOT DEFINED INCLUDE_DIR)
    message(FATAL_ERROR "INCLUDE_DIR must be defined")
endif()

file(GLOB_RECURSE headers "${INCLUDE_DIR}/*.hpp")

if(NOT headers)
    message(FATAL_ERROR "no headers found under ${INCLUDE_DIR}")
endif()

foreach(header ${headers})
    file(READ "${header}" contents)
    string(TOLOWER "${contents}" lowered)
    if(lowered MATCHES "<openssl/")
        message(FATAL_ERROR "${header} depends on OpenSSL headers")
    endif()
    if(lowered MATCHES "<mbedtls")
        message(FATAL_ERROR "${header} depends on mbedTLS headers")
    endif()
    if(lowered MATCHES "<switch(\\.h|/)")
        message(FATAL_ERROR "${header} exposes libnx headers")
    endif()
    if(lowered MATCHES "<microecc/")
        message(FATAL_ERROR "${header} exposes micro-ecc headers")
    endif()
    if(lowered MATCHES "<(windows|winsock2|ws2tcpip)\\.h>")
        message(FATAL_ERROR "${header} exposes Win32 headers")
    endif()
    if(lowered MATCHES "<pthread\\.h>")
        message(FATAL_ERROR "${header} exposes pthread headers")
    endif()
    if(lowered MATCHES "<(sys/socket|syslog|os/log)\\.h>")
        message(FATAL_ERROR "${header} exposes platform backend headers")
    endif()
endforeach()
