if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR must be defined")
endif()

set(public_root "${SOURCE_DIR}/include/libchiaking")
set(domains users consoles catalog trophies messages play kakusan)
set(allowed_users)
set(allowed_consoles users)
set(allowed_catalog users)
set(allowed_trophies users)
set(allowed_messages users)
set(allowed_play users consoles catalog)
set(allowed_kakusan users consoles catalog play)
set(public_folders detail platform testing)
set(violations)

set(top_level chiaki_ng.hpp version.hpp)
foreach(domain IN LISTS domains)
    list(APPEND top_level "${domain}.hpp" "${domain}_types.hpp")
endforeach()
file(GLOB top RELATIVE "${public_root}" "${public_root}/*")
foreach(entry IN LISTS top)
    if(NOT entry IN_LIST top_level AND NOT entry IN_LIST public_folders)
        list(APPEND violations "include/libchiaking/${entry} is outside the agreed public tree")
    endif()
endforeach()
foreach(header IN LISTS top_level public_folders)
    if(NOT EXISTS "${public_root}/${header}")
        list(APPEND violations "include/libchiaking/${header} is missing")
    endif()
endforeach()

foreach(domain IN LISTS domains)
    foreach(kind IN ITEMS "" "_types")
        set(header "${public_root}/${domain}${kind}.hpp")
        if(NOT EXISTS "${header}")
            continue()
        endif()
        file(STRINGS "${header}" lines)
        foreach(line IN LISTS lines)
            if(line STREQUAL "" OR line STREQUAL "#pragma once" OR line MATCHES "^///")
                continue()
            endif()
            if(kind STREQUAL "" AND line MATCHES
                    "^(namespace libchiaking::[a-z_]+ {|}  // namespace libchiaking::[a-z_]+|(class|struct) [A-Za-z_][A-Za-z0-9_]*;?)$")
                continue()
            endif()
            if(NOT line MATCHES "^#include \"libchiaking/([a-z_]+)(/[a-z_/]+)?\\.hpp\"$")
                list(APPEND violations "${domain}${kind}.hpp holds more than includes: ${line}")
                continue()
            endif()
            string(REGEX REPLACE "^#include \"libchiaking/(detail/)?([a-z_]+)[/.].*$" "\\2" named "${line}")
            string(REGEX REPLACE "_types$" "" named "${named}")
            if(named IN_LIST domains AND NOT named STREQUAL domain AND NOT named IN_LIST allowed_${domain})
                list(APPEND violations "${domain}${kind}.hpp includes a domain above it: ${line}")
            endif()
            if(kind STREQUAL "_types" AND NOT line MATCHES "\"libchiaking/(detail/|[a-z_]+_types\\.hpp)")
                list(APPEND violations "${domain}_types.hpp includes outside detail: ${line}")
            endif()
            if(kind STREQUAL "" AND NOT line MATCHES "\"libchiaking/(detail/${domain}/|[a-z_]+\\.hpp\")")
                list(APPEND violations "${domain}.hpp includes outside its own detail folder: ${line}")
            endif()
        endforeach()
    endforeach()
endforeach()

file(GLOB_RECURSE everything
    "${SOURCE_DIR}/src/*.hpp" "${SOURCE_DIR}/src/*.cpp" "${SOURCE_DIR}/src/*.h" "${SOURCE_DIR}/src/*.c"
    "${SOURCE_DIR}/include/*.hpp" "${SOURCE_DIR}/include/*.h"
    "${SOURCE_DIR}/tests/*.hpp" "${SOURCE_DIR}/tests/*.cpp" "${SOURCE_DIR}/tests/*.h"
    "${SOURCE_DIR}/samples/*.hpp" "${SOURCE_DIR}/samples/*.cpp"
    "${SOURCE_DIR}/tools/*.hpp" "${SOURCE_DIR}/tools/*.cpp")
foreach(file IN LISTS everything)
    file(RELATIVE_PATH relative "${SOURCE_DIR}" "${file}")
    file(STRINGS "${file}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]libchiaking/")
    set(is_face FALSE)
    set(is_types FALSE)
    set(is_internal FALSE)
    if(relative MATCHES "^include/libchiaking/(users|consoles|catalog|trophies|messages|play|kakusan)\\.hpp$")
        set(is_face TRUE)
    elseif(relative MATCHES "^include/libchiaking/(users|consoles|catalog|trophies|messages|play|kakusan)_types\\.hpp$")
        set(is_types TRUE)
    elseif(relative MATCHES "^(src/|include/libchiaking/[a-z_]+/)")
        set(is_internal TRUE)
    endif()
    set(may_see_detail FALSE)
    if(is_types OR is_face OR relative STREQUAL "include/libchiaking/chiaki_ng.hpp"
            OR relative MATCHES "^(src/|include/libchiaking/(detail|platform|testing)/)")
        set(may_see_detail TRUE)
    elseif(relative MATCHES "^tests/" AND NOT relative MATCHES "^tests/packaging/")
        file(STRINGS "${file}" private_includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"src/")
        if(private_includes)
            set(may_see_detail TRUE)
        endif()
    endif()
    if(relative MATCHES "^include/")
        file(STRINGS "${file}" source_includes REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<](src|tests|tools|samples)/")
        foreach(line IN LISTS source_includes)
            list(APPEND violations "${relative} is a public header and includes the source tree: ${line}")
        endforeach()
    endif()
    foreach(line IN LISTS includes)
        if(line MATCHES "libchiaking/detail/" AND NOT may_see_detail)
            list(APPEND violations "${relative} includes a detail header directly: ${line}")
        endif()
        if(line MATCHES "libchiaking/chiaki_ng\\.hpp" AND NOT relative MATCHES "^src/(core/chiaki_ng|assembly/stock_chiaki_ng)\\.cpp$"
                AND NOT relative MATCHES "^(tests|samples|tools)/")
            list(APPEND violations "${relative} is below the main class and includes it: ${line}")
        endif()
        if(is_internal AND line MATCHES "libchiaking/(users|consoles|catalog|trophies|messages|play|kakusan)(_types)?\\.hpp")
            list(APPEND violations "${relative} is inside the core and includes a face: ${line}")
        endif()
    endforeach()
endforeach()

file(GLOB core_top RELATIVE "${SOURCE_DIR}/src/core" "${SOURCE_DIR}/src/core/*.cpp" "${SOURCE_DIR}/src/core/*.hpp")
list(SORT core_top)
if(NOT core_top STREQUAL "chiaki_ng.cpp;version.cpp")
    list(APPEND violations "src/core holds loose files other than chiaki_ng.cpp and version.cpp: ${core_top}")
endif()

if(violations)
    list(JOIN violations "\n" report)
    message(FATAL_ERROR "the public faces are not as agreed:\n${report}")
endif()
